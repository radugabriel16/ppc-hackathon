logging {
	level  = "info"
	format = "json"
}

discovery.docker "filegrid" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "15s"

	filter {
		name   = "label"
		values = [string.format("com.docker.compose.project=%s", sys.env("COMPOSE_PROJECT_NAME"))]
	}
}

discovery.relabel "filegrid" {
	targets = discovery.docker.filegrid.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}
}

loki.source.docker "filegrid" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.filegrid.output
	refresh_interval = "15s"
	forward_to       = [loki.process.filegrid.receiver]
}

loki.process "filegrid" {
	// Preserve the JSON line. IDs are parsed fields/structured metadata, not labels.
	stage.json {
		expressions = {
			request_id = "requestId",
			level      = "level",
			timestamp  = "timestamp",
		}
	}

	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	stage.labels {
		values = {level = ""}
	}

	stage.structured_metadata {
		values = {requestId = "request_id"}
	}
	forward_to = [loki.write.filegrid.receiver]
}

loki.write "filegrid" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
