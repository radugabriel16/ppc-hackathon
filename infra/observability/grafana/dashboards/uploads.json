  "panels": [
    {
      "id": 1,
      "title": "Session and availability scope",
      "type": "text",
      "pluginVersion": "11.0.0",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Session gauges are per exporter** and have no category label in §4; they are never summed across jobs/instances because shared-session ownership is unspecified. The category selector applies to availability histograms only. Availability quantiles measure completed histogram observations; stalled/unready files are not included. The instrumentation does not distinguish resumable uploads from other file flows in these category-level observations."
      }
    },
    {
      "id": 2,
      "title": "Active upload sessions — per exporter",
      "description": "Current gauge, one value per exporter. Category filtering is intentionally not applied to an unlabelled application metric.",
      "type": "stat",
      "pluginVersion": "11.0.0",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "filegrid_upload_sessions_active{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "editorMode": "code",
          "legendFormat": "{{job}} / {{instance}}",
          "format": "time_series",
          "instant": true,
          "range": false,
          "exemplar": false
        }
      ]
    },
