  "panels": [
    {
      "id": 1,
      "title": "Reading this dashboard",
      "type": "text",
      "pluginVersion": "11.0.0",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Metrics: **PHASE1.md §4** · datasource **prometheus**. Histograms use standard `_bucket` / `_count` series. Job/instance scope every query; category/storage/operation scope storage panels, and category scopes availability/rejection panels. Ingestion and upload-session gauges have no category label. **No data is not a healthy zero.** Circuit states follow the verified backend encoding: 0 closed, 1 half-open, 2 open. Upload gauges are shown per exporter to avoid double-counting shared session inventories."
      }
    },
    {
      "id": 2,
      "title": "API requests / second",
      "description": "",
      "type": "stat",
      "pluginVersion": "11.0.0",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
