  "panels": [
    {
      "id": 1,
      "title": "Comparison scope and outcome convention",
      "type": "text",
      "pluginVersion": "11.0.0",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Select the same **operation** for fair storage comparisons; All combines operation distributions. Quantiles aggregate histogram **bucket rates by le/category/storage**, not averages of instance quantiles. Error fraction = (all operations − successful operations) / all operations. Set **Successful outcome** to the exporter’s exact success label; The backend emits `success` for successful operations (verified in storage/resilience.py). If the success series is missing or there are no operations, the ratio stays **No data**, not a fabricated zero. Bytes are transferred I/O, not stored capacity. Missing matrix cells remain empty."
      }
    },
    {
      "id": 2,
      "title": "p50 latency — category × storage",
      "description": "Median operation duration over the rate interval.",
      "type": "table",
      "pluginVersion": "11.0.0",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "category\\storage"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Category / Storage"
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, category, storage) (rate(filegrid_storage_operation_duration_seconds_bucket{job=~\"${job:regex}\",instance=~\"${instance:regex}\",category=~\"${category:regex}\",storage=~\"${storage:regex}\",operation=~\"${operation:regex}\"}[$__rate_interval])))",
          "editorMode": "code",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false,
          "exemplar": false
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "storage",
            "rowField": "category",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
