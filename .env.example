# FileGrid environment configuration (placeholders only — never commit real secrets)

# Roles: ingest | files | worker
ROLE=files

# catalog-db (PostgreSQL + PostGIS)
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=filegrid_catalog
CATALOG_DB_USER=filegrid

# storage-db (separate PostgreSQL, BYTEA content only)
STORAGE_DB_HOST=storage-db
STORAGE_DB_PORT=5432
STORAGE_DB_NAME=filegrid_storage
STORAGE_DB_USER=filegrid

# SeaweedFS (S3-compatible)
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=filegrid

# FTP
FTP_HOST=ftp
FTP_PORT=2121
FTP_USER=filegrid

# Session / CSRF
SESSION_COOKIE_NAME=filegrid_session
SESSION_TTL_SECONDS=28800
APP_ORIGIN=https://localhost

# Secrets directory (populated by the init container)
SECRETS_DIR=/run/secrets

# Logging
LOG_LEVEL=INFO

# Frontend
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
